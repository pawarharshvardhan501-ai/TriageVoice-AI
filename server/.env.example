# ==========================================
# TriageVoice AI — Server Environment Config
# ==========================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Clinical JWT Security
JWT_SECRET=super_secret_clinical_jwt_key_98765
ADMIN_REGISTRATION_KEY=triage-admin-secure-2025

# Google Gemini GenAI API Key (gemini-2.5-flash)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Supabase Cloud PostgreSQL
# Found in Project Settings -> API & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct PostgreSQL Connection for migrations (optional)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
